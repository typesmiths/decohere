{
  "name": "decohere",
  "version": "0.0.1-dev.5",
  "description": "",
  "license": "ISC",
  "author": "typesmiths",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typesmiths/decohere.git"
  },
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "forge:build": "pnpm forge build",
    "forge:build:watch": "pnpm forge build --watch",
    "lint": "oxlint --fix && prettier --write .",
    "lint:check": "oxlint --deny-warnings && prettier --check . && pnpm -s forge paths --check",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "qa": "pnpm run lint:check && pnpm run typecheck && pnpm run test",
    "test": "vitest run --project unit --silent=passed-only",
    "test:file": "vitest run --project unit --silent=passed-only",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e --silent=passed-only",
    "test:coverage": "vitest run --project unit --coverage --silent=passed-only",
    "test:coverage:report": "node projects/ci-tools/src/coverage/report.mjs",
    "bench": "node projects/ci-tools/src/bench/bench.mjs run",
    "bench:save": "node projects/ci-tools/src/bench/bench.mjs save",
    "perf:trace": "BENCH_CONFIGURATION=types-only BENCH_ITERATIONS=2 BENCH_ANALYZE_TRACE=1 BENCH_TRACE_LOG=1 node projects/ci-tools/src/bench/trace.mjs",
    "changeset:check": "node projects/ci-tools/src/changeset/check-status.mjs",
    "version:aggregate": "node projects/ci-tools/src/changeset/aggregate-changelog.mjs",
    "npm:bootstrap": "node projects/ci-tools/src/github/npm-bootstrap.mjs",
    "npm:trust-promote": "node projects/ci-tools/src/github/npm-trust-promote.mjs",
    "forge": "node --import ./tools/register.mjs projects/cli/src/forge.ts",
    "flux": "node --import ./tools/register.mjs projects/cli/src/flux.ts",
    "test:docker": "vitest run --project docker --silent=passed-only"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@fastify/compress": "^9.2.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/postgresql": "^7.2.8",
    "@swc/core": "^1.11.11",
    "ajv": "^8.20.0",
    "async": "^3.2.6",
    "commander": "^13.1.0",
    "fastify": "^5.12.8",
    "get-tsconfig": "^4.14.3",
    "glob": "^14.0.4",
    "jose": "^6.2.3",
    "parse-imports": "^2.2.1",
    "pg": "^8.23.1",
    "picomatch": "^4.0.4",
    "pino": "^10.3.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@swc/types": "^0.1.21",
    "@types/async": "^3.2.25",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.16.0",
    "@types/picomatch": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axios": "^1.16.0",
    "memfs": "^4.17.0",
    "oxlint": "1.87.0",
    "pino-roll": "^4.0.0",
    "prettier": "3.9.10",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "brace-expansion@^2.0.0": "2.1.7",
      "brace-expansion@^4.0.0": "5.0.12",
      "brace-expansion@^5.0.0": "5.0.12",
      "fast-uri": "3.1.9",
      "fastify": "5.12.8",
      "find-my-way": "9.9.0",
      "follow-redirects": "1.16.2",
      "form-data": "4.0.6",
      "glob@^10.0.0": "14.0.4",
      "js-yaml@^3.0.0": "3.15.2",
      "js-yaml@^4.0.0": "4.3.2",
      "lodash": "4.18.1",
      "nanoid@^3.0.0": "3.3.18",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.5",
      "picomatch": "4.0.5",
      "postcss": "8.5.26",
      "ip-address": "10.7.6",
      "uuid@^8.0.0": "11.1.1",
      "yaml@^1.0.0": "1.10.3",
      "source-map-js": "1.2.2"
    }
  }
}
